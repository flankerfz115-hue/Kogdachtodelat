name: notify

on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:
    inputs:
      test:
        description: "Прислать тестовое уведомление"
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: notify

jobs:
  notify:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4

      - name: Есть ли данные
        id: check
        run: |
          if git ls-remote --exit-code --heads origin data > /dev/null; then
            echo "ok=1" >> "$GITHUB_OUTPUT"
          else
            echo "Ветки data ещё нет — подключи GitHub в приложении"
          fi

      - if: steps.check.outputs.ok
        uses: actions/checkout@v4
        with:
          ref: data
          path: .data

      - if: steps.check.outputs.ok
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: notify/requirements.txt

      - if: steps.check.outputs.ok
        run: pip install -q -r notify/requirements.txt

      - if: steps.check.outputs.ok
        env:
          DATA_KEY: ${{ secrets.DATA_KEY }}
          TEST: ${{ inputs.test }}
        run: python notify/send.py .data

      - name: Запомнить отправленное
        if: steps.check.outputs.ok
        working-directory: .data
        run: |
          if [ -n "$(git status --porcelain)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add sent.json
            git commit -q -m "Отправленные уведомления"
            git pull -q --rebase && git push -q
          fi
